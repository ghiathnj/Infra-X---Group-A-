    {
      "name": "Authenticated reads",
      "item": [
        {
          "name": "GET all forms (no token → 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthorized without token', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{clinicalUrl}}/api/clinical/forms",
              "host": ["{{clinicalUrl}}"],
              "path": ["api", "clinical", "forms"]
            }
          }
        },
        {
          "name": "GET all forms (with token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{clinicalUrl}}/api/clinical/forms",
              "host": ["{{clinicalUrl}}"],
              "path": ["api", "clinical", "forms"]
            }
          }
        },
        {
          "name": "GET form by id (with token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id matches', () => pm.expect(String(body.id)).to.equal(pm.environment.get('formId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{clinicalUrl}}/api/clinical/forms/{{formId}}",
              "host": ["{{clinicalUrl}}"],
              "path": ["api", "clinical", "forms", "{{formId}}"]
            }
          }
        },
        {
          "name": "GET form by id — not found (9999)",
          "event": [
