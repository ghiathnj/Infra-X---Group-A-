    {
      "name": "Admin",
      "item": [
        {
          "name": "PATCH diagnosis and notes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('diagnosis saved', () => pm.expect(body.diagnosis).to.equal('common cold'));",
                  "pm.test('notes saved', () => pm.expect(body.notes).to.equal('follow up in 1 week'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosis\": \"common cold\",\n  \"notes\": \"follow up in 1 week\"\n}"
            },
            "url": {
              "raw": "{{clinicalUrl}}/api/clinical/forms/{{formId}}/admin",
              "host": ["{{clinicalUrl}}"],
              "path": ["api", "clinical", "forms", "{{formId}}", "admin"]
            }
          }
        }
      ]
    },
    {
      "name": "CORS preflight",
      "item": [
        {
          "name": "OPTIONS /api/clinical/forms (Origin localhost:3000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Allow-Origin matches', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.equal('http://localhost:3000'));",
                  "pm.test('POST allowed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:3000" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "content-type" }
            ],
            "url": {
              "raw": "{{clinicalUrl}}/api/clinical/forms",
              "host": ["{{clinicalUrl}}"],
              "path": ["api", "clinical", "forms"]
            }
          }
        }
      ]
    }
